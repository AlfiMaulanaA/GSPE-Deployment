generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int
  typeId      String      // Relasi ke ProductType
  type        ProductType @relation(fields: [typeId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProductType {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}
